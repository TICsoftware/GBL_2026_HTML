@{
    ViewData["Title"] = "2-Ethyl-1,3-Hexanediol";
}

@section Styles {
   <link rel="stylesheet" href="~/Assets/css/swiper-bundle.min.css" asp-append-version="true" />
   <link rel="stylesheet" href="~/Assets/css/insidepage-style.css" asp-append-version="true" />
   <link rel="stylesheet" href="~/Assets/css/product-only-inside.css" asp-append-version="true" />
}
   <!--===========================
   Product Hero Banner
   ============================-->
   <section class="product-inside-banner-outer section-spacing">
      <div class="container">
         <div class="product-inside-banner ">
            <div class="product-inside-banner__copy ">               
               <!--Breadcrumb-->             
               <nav class="breadcrumb-nav" aria-label="Breadcrumb">
                  <ol class="flex items-center gap-2 text-sm">
                     <li><a href="/" class="transition">Home</a></li>
                     <li>/</li>
                     <li><a href="/" class="transition">Product</a></li>
                     <li>/</li>
                     <li class="active">Bio-based Chemicals</li>
                  </ol>
               </nav>            

               <div class="title-section">
                  <h1 class="text-h1 title-animation">2-Ethyl-1,3-Hexanediol</h1>
               </div>

               <div class="page-intro-inner product-inside-banner__intro">
                  <p>2-Ethyl-1,3-Hexanediol is a colourless viscous liquid, which is used as a plasticiser in the plastics and resins industry. It is also used in ink formulations, where it increases the penetration properties of ink on paper.</p>
               </div>
            </div>

            <div class="product-inside-banner__media">
               <img src="@Url.Content("~/Assets/images/banners/inside-banner1.webp")" alt="2-Ethyl-1,3-Hexanediol">
            </div>
         </div>
      </div>
   </section>
   <!--===========================
   / Product Hero Banner END
   ============================-->

   <!--===========================
   Packaging / Application
   ============================-->
   <section class="packaging-application-outer section-spacing">
     <div class="container">
        <div class="packaging-application">
           <div class="packaging-block">
              <div class="packaging-block__head">
                  <div class="title-section">
                     <h2 class="text-h2 title-animation">Packaging</h2>
                  </div>
                 
                 <div class="packaging-block__nav" hidden>
                    <button type="button" class="packaging-nav packaging-nav--prev" aria-label="Previous packaging">
                       <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 5L8 12l7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                    <div class="packaging-pagination"></div>
                    <button type="button" class="packaging-nav packaging-nav--next" aria-label="Next packaging">
                       <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                 </div>
              </div>

              <div class="swiper packaging-swiper">
                 <div class="swiper-wrapper">
                    <div class="swiper-slide">
                       <figure class="packaging-card image-card">
                          <div class="image-box"><img src="@Url.Content("~/Assets/images/industry-page/img5.webp")" alt="HDPE drums"></div>
                          <figcaption>HDPE drums</figcaption>
                       </figure>
                    </div>
                    <div class="swiper-slide">
                       <figure class="packaging-card image-card">
                           <div class="image-box"><img src="@Url.Content("~/Assets/images/industry-page/img6.webp")" alt="ISO tanks"></div>
                          <figcaption>ISO tanks</figcaption>
                       </figure>
                    </div>   

                     <div class="swiper-slide">
                       <figure class="packaging-card image-card">
                          <div class="image-box"><img src="@Url.Content("~/Assets/images/industry-page/img5.webp")" alt="HDPE drums"></div>
                          <figcaption>HDPE drums</figcaption>
                       </figure>
                    </div>
                    <div class="swiper-slide">
                       <figure class="packaging-card image-card">
                           <div class="image-box"><img src="@Url.Content("~/Assets/images/industry-page/img6.webp")" alt="ISO tanks"></div>
                          <figcaption>ISO tanks</figcaption>
                       </figure>
                    </div>                    
                 </div>
              </div>
           </div>

           <div class="application-block">
               <div class="title-section">
                     <h2 class="text-h2 title-animation">Applications</h2>
               </div>
              <ul class="application-list">
                 <li>Diol or solvent in urethane manufacturing</li>
                 <li>Hardener in adhesive systems</li>
                 <li>Solvent in the manufacture of glycol inks</li>
                 <li>Insect repellent and selective suckering inhibitor for various kinds of plants</li>
                 <li>Coupling agent for shampoos and liquid cleansing creams</li>
                 <li>Lubricant in textile spinning</li>
                 <li>Ingredient in enamels</li>
              </ul>
           </div>
        </div>
     </div>
   </section>


   <!--===========================
   Technical Overview / Safety Data Sheet (SDS)
   ============================-->
   <section class="technical-Safety-outer section-spacing">
     <div class="container">
        <div class="packaging-application">
           <div class="packaging-block">
              
                  <div class="title-section">
                     <h2 class="text-h2 title-animation">Technical Overview</h2>
                  </div>  
          
              <div class="tech-overview">
                 <table class="tech-overview-table">
                    <thead>
                       <tr>
                          <th>Property</th>
                          <th>Specification</th>
                       </tr>
                    </thead>
                    <tbody>
                       <tr>
                          <td>Appearance</td>
                          <td>Colourless to pale yellow liquid</td>
                       </tr>
                       <tr>
                          <td>Assay (%)</td>
                          <td>Min 98.00</td>
                       </tr>
                       <tr>
                          <td>Acidity as Butyric Acid (%)</td>
                          <td>Max 0.50</td>
                       </tr>
                       <tr>
                          <td>Moisture (%)</td>
                          <td>Max 1.00</td>
                       </tr>
                    </tbody>
                 </table>
              </div>
           </div>

           <div class="application-block">
               <div class="title-section">
                     <h2 class="text-h2 title-animation">Safety Data Sheet (SDS)</h2>
               </div>
               <div class="sds-panel">
                  <p class="sds-panel__name">2-Ethyl-1,3-Hexanediol</p>
                  <div class="sds-panel__actions">
                     <a href="@Url.Content("~/Assets/docs/2-Ethyl-1,3-Hexanediol-SDS.pdf")" class="site-btn site-btn--fill">
                        <span class="site-btn__label">Download (Pdf)</span>
                        <span class="site-btn__arrow" aria-hidden="true">
                           <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </span>
                     </a>
                     <a href="#" class="site-btn site-btn--outline">
                        <span class="site-btn__label">Order Sample / Enquire Now</span>
                        <span class="site-btn__arrow" aria-hidden="true">
                           <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </span>
                     </a>
                  </div>
               </div>
           </div>
        </div>
     </div>
   </section>

@section Scripts {
   <script src="~/Assets/js/swiper-bundle.min.js" asp-append-version="true"></script>
   <script src="~/Assets/js/product-only-inside.js" asp-append-version="true"></script>

}
