@{
    ViewData["Title"] = "Corporate governance";
    var pdfBase = "https://www.godavaribiorefineries.com/sites/default/files/";
}

@section Styles {
   <link rel="stylesheet" href="~/Assets/css/insidepage-style.css" asp-append-version="true" />   
   <link rel="stylesheet" href="~/Assets/css/corporate-governance-intro.css" asp-append-version="true" />
}

    <!-- HERO BANNER END-->
   <section class="relative inside-banner-outer">
         <div class="inside-banner-inner banner-animation relative">
            <!-- Banner -->
            <div class="overflow-hidden h-[75vh] sm:h-[700px] relative innerbanner-image-wrapper">
               <!-- Parallax Image -->
               <picture>
                  <!-- Desktop -->
                  <source media="(min-width:1024px)"
                     srcset="~/Assets/images/banners/corporate-governance-banner.webp">                  

                  <!-- Desktop -->
                  <img
                     src="~/Assets/images/banners/corporate-governance-banner.webp"
                     alt=""
                     class="innerbanner-image absolute left-0 top-0 w-full h-full object-cover"
                     loading="eager"
                     fetchpriority="high">
               </picture>
               <!-- Keep Existing Overlay -->
               <div class="innerbanner-overlay"></div>
            </div>
            <!-- Content -->
           
           <!--Breadcrumb-->
            <div class="innerbanner-caption absolute inset-0 z-30 flex items-center">
               <div class="container">
                  <div class="max-w-4xl text-left">
                     <h1 class="innerbanner-title text-h1 text-white title-animation">
                           Corporate Governance
                     </h1>

                     <nav class="breadcrumb-nav" aria-label="Breadcrumb">
                        <ol class="flex items-center gap-2 text-sm">
                           <li>
                              <a href="/" class="text-white/70 hover:text-white transition">
                                 Home
                              </a>
                           </li>

                           <li class="text-white/60">/</li>

                           <li>
                              <a href="/" class="text-white/70 hover:text-white transition">
                                 Investor Relations
                              </a>
                           </li>

                           <li class="text-white/60">/</li>

                           <li class="text-white">
                              Corporate governance
                           </li>
                        </ol>
                     </nav>
                  </div>
               </div>
            </div>  
         </div>
   </section>
    <!-- HERO BANNER END -->

  

   <div class="cg-page">
   <div class="cg-jump-sentinel" aria-hidden="true"></div>
   <section class="cg-jump" aria-label="Corporate governance sections">
      <div class="container">
         <div class="cg-jump__track">
            <button type="button" class="cg-jump__arrow cg-jump__arrow--prev" aria-label="Previous section">
               <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14.5 6 8.5 12l6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <nav class="cg-jump__nav">
               <a class="cg-jump__btn" href="#policies">Policies</a>
               <a class="cg-jump__btn" href="#code-of-conduct">Code of Conduct</a>
               <a class="cg-jump__btn" href="#committees">Committees of the Board</a>
            </nav>
            <button type="button" class="cg-jump__arrow cg-jump__arrow--next" aria-label="Next section">
               <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9.5 6 15.5 12l-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
         </div>
      </div>
   </section>

