@{
    ViewData["Title"] = "Learning & Development";
}

@section Styles {
   <link rel="stylesheet" href="~/Assets/css/insidepage-style.css" asp-append-version="true" />
   <link rel="stylesheet" href="~/Assets/css/careers-style.css" asp-append-version="true" />
}

    <!-- HERO BANNER END-->
   <section class="relative inside-banner-outer">
         <div class="inside-banner-inner banner-animation relative">
            <!-- Banner -->
            <div class="overflow-hidden h-[75vh] sm:h-[700px] relative innerbanner-image-wrapper">
               <!-- Parallax Image -->
               <picture>
                  <!-- Desktop -->
                  <source media="(min-width:1024px)"
                     srcset="~/Assets/images/banners/learningdevelopment-desktop.webp">

                  <!-- Tablet -->
                  <source media="(min-width:992px)"
                     srcset="~/Assets/images/banners/learningdevelopment-mob.webp">

                  <!-- Mobile -->
                  <img
                     src="~/Assets/images/banners/learningdevelopment-desktop.webp"
                     alt=""
                     class="innerbanner-image absolute left-0 top-0 w-full h-full object-cover"
                     loading="eager"
                     fetchpriority="high">
               </picture>
               <!-- Keep Existing Overlay -->
               <div class="innerbanner-overlay"></div>
            </div>
            <!-- Content -->
           
           <!--Breadcrumb-->
            <div class="innerbanner-caption absolute inset-0 z-30 flex items-center">
               <div class="container">
                  <div class="max-w-4xl text-left">
                     <h1 class="innerbanner-title text-h1 text-white title-animation">
                        Learning & Development
                     </h1>

                     <nav class="breadcrumb-nav" aria-label="Breadcrumb">
                        <ol class="flex items-center gap-2 text-sm">
                           <li>
                              <a href="/" class="text-white/70 hover:text-white transition">
                                 Home
                              </a>
                           </li>

                           <li class="text-white/60">/</li>

                           <li class="text-white">
                               <a href="/" class="text-white/70 hover:text-white transition">  Careers </a>
                           </li>
                           <li class="text-white/60">/</li>

                           <li class="text-white">
                                 Learning & Development
                           </li>

                        </ol>
                     </nav>
                  </div>
               </div>
            </div>  
         </div>
   </section>
    <!-- HERO BANNER END -->

   <!--PAGE INTRO OUTER-->
   <section class="relative overflow-hidden section-spacing page-intro-outer bg-gray">
       <div class="container">
         <div class="page-intro-inner intro-lg text-center">
            <p>At Godavari Biorefineries, learning is a continuous journey. We believe that investing in our people is essential to driving innovation, building future capabilities, and creating long-term success.</p>
         </div>      
      </div>
   </section>
   <!--PAGE INTRO OUTER END-->

   <section class="middle-container learningBody section-spacing">
      <div class="container middle-container-inner">
         <article class="learningBand common-media-section">
            <div class="parallax-wrap" aria-hidden="true">
               <img src="@Url.Content("~/Assets/images/careers/ld-1.webp")" alt="" class="parallax-img">
            </div>
            <div class="learningBand-caption common-media-caption">
               <h2 class="text-h2">Empowering Growth. Enabling Excellence.</h2>
               <p>Our Learning &amp; Development programme is designed to help employees learn, build expertise, expand perspectives, and prepare for new opportunities throughout their careers.</p>
            </div>
         </article>

         <div class="learningCopy">
            <h3>Building Future-Ready Talent</h3>
            <p>We create a structured learning roadmap aligned with evolving business priorities and industry developments. These programmes are designed to support employees at every stage of their professional journey.</p>

            <h3>Technical Capability Enhancement</h3>
            <p>Employees have access to specialised technical training programmes that deepen functional expertise and strengthen professional capabilities across manufacturing, engineering, research, agriculture, and business functions.</p>

            <h3>Leadership Development</h3>
            <p>We invest in developing future leaders through programmes that build strategic thinking, decision-making, collaboration, and people leadership skills.</p>

            <h3>Cross-Functional Learning</h3>
            <p>Our integrated business model creates opportunities for employees to learn across functions, broaden their understanding of the value chain, and develop multidisciplinary perspectives.</p>
         </div>

         <article class="common-media-section">
            <div class="parallax-wrap" aria-hidden="true">
               <img src="@Url.Content("~/Assets/images/careers/ld-2.webp")" alt="" class="parallax-img">
            </div>
            <div class="common-media-caption">
               <h2 class="text-h2">A Culture of Knowledge Sharing</h2>
            </div>
         </article>

         <div class="learningCopy">
            <p>Learning at Godavari Biorefineries extends beyond formal programmes.</p>
            <p>Experienced professionals actively contribute to capability building through mentoring, coaching, and structured knowledge-sharing initiatives. Employees are encouraged to learn from practical experiences, exchange ideas, and collaborate across teams.</p>
            <p>This culture of continuous learning helps strengthen both individual capabilities and organisational expertise.</p>
         </div>

         <article class="common-media-section">
            <div class="parallax-wrap" aria-hidden="true">
               <img src="@Url.Content("~/Assets/images/careers/ld-3.webp")" alt="" class="parallax-img">
            </div>
            <div class="common-media-caption">
               <h2 class="text-h2">Expanding Professional Horizons</h2>
               <p>To support lifelong learning, employees are encouraged to participate in</p>
            </div>
         </article>

         <div class="learningCopy">
            <p>To support lifelong learning, employees are encouraged to participate in:</p>
            <ul class="list-icon">
               <li>
                  <img src="@Url.Content("~/Assets/images/common-images/drone.svg")" alt="">
                  <span>Professional certification programmes</span>
               </li>
               <li>
                  <img src="@Url.Content("~/Assets/images/common-images/drone.svg")" alt="">
                  <span>External workshops and seminars</span>
               </li>
               <li>
                  <img src="@Url.Content("~/Assets/images/common-images/drone.svg")" alt="">
                  <span>Industry conferences and forums</span>
               </li>
               <li>
                  <img src="@Url.Content("~/Assets/images/common-images/drone.svg")" alt="">
                  <span>Continuing education initiatives</span>
               </li>
               <li>
                  <img src="@Url.Content("~/Assets/images/common-images/drone.svg")" alt="">
                  <span>Skill enhancement programmes</span>
               </li>
            </ul>
            <p>These opportunities help employees stay aligned with evolving industry practices and emerging technologies.</p>
         </div>

         <article class="common-media-section">
            <div class="parallax-wrap" aria-hidden="true">
               <img src="@Url.Content("~/Assets/images/careers/ld-4.webp")" alt="" class="parallax-img">
            </div>
            <div class="common-media-caption">
               <h2 class="text-h2">Our Learning Philosophy</h2>
            </div>
         </article>

         <div class="learningCopy">
            <p>By igniting curiosity, encouraging continuous improvement, and investing in capability building, we enable our people to reach their full potential and build rewarding careers.</p>
            <a href="#" class="site-btn site-btn--outline">
               <span class="site-btn__label">Be a part of our talent pool</span>
               <span class="site-btn__arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
               </span>
            </a>
         </div>
      </div>
   </section>

