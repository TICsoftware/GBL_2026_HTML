@{
    ViewData["Title"] = "Industries";
}

@section Styles {
   <link rel="stylesheet" href="~/Assets/css/insidepage-style.css" asp-append-version="true" />
   <link rel="stylesheet" href="~/Assets/css/industries-style.css" asp-append-version="true" />
   <link rel="stylesheet" href="~/Assets/css/industries-tab.css" asp-append-version="true" />
}

    <!-- HERO BANNER END-->
   <section class="relative inside-banner-outer">
         <div class="inside-banner-inner banner-animation relative">
            <!-- Banner -->
            <div class="overflow-hidden h-[75vh] sm:h-[700px] relative innerbanner-image-wrapper">
               <!-- Parallax Image -->
               <picture>
                  <!-- Desktop -->
                  <source media="(min-width:1024px)"
                     srcset="~/Assets/images/banners/AdhesivesLubricants-desktop.webp">
                  

                  <!-- Mobile -->
                  <img
                     src="~/Assets/images/banners/AdhesivesLubricants-desktop.webp"
                     alt=""
                     class="innerbanner-image absolute left-0 top-0 w-full h-full object-cover"
                     loading="eager"
                     fetchpriority="high">
               </picture>
               <!-- Keep Existing Overlay -->
               <div class="innerbanner-overlay"></div>
            </div>
            <!-- Content -->
           
           <!--Breadcrumb-->
            <div class="innerbanner-caption absolute inset-0 z-30 flex items-center">
               <div class="container">
                  <div class="max-w-4xl text-left">
                     <h1 class="innerbanner-title text-h1 text-white title-animation">
                       Adhesives & Lubricants
                     </h1>

                     <nav class="breadcrumb-nav" aria-label="Breadcrumb">
                        <ol class="flex items-center gap-2 text-sm">
                           <li>
                              <a href="/" class="text-white/70 hover:text-white transition">
                                 Home
                              </a>
                           </li>

                           <li class="text-white/60">/</li>

                           <li>
                              <a href="/industries" class="text-white/70 hover:text-white transition">
                                 Industries
                              </a>
                           </li>

                           <li class="text-white/60">/</li>

                           <li class="text-white">
                              Adhesives & Lubricants
                           </li>
                        </ol>
                     </nav>
                  </div>
               </div>
            </div>  
         </div>
   </section>
    <!-- HERO BANNER END -->

   <!--PAGE INTRO OUTER-->
   <section class="relative overflow-hidden section-spacing page-intro-outer bg-gray">
       <div class="container">
         <div class="page-intro-inner intro-lg text-center">
            <p>We provide key ingredients for adhesives, sealants and structural binders and specialised raw materials derived from renewable resources for the lubricants industry. Our advanced chemicals enable manufacturers to develop adhesive products that deliver exceptional flexibility and superior bond strength. Our experience in high-friction applications means that our lubricant chemicals ensure peak mechanical efficiency and smooth component operations.</p>
         </div>      
      </div>
   </section>
   <!--PAGE INTRO OUTER END-->

