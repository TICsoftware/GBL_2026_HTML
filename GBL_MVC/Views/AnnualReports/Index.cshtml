                  <span class="ar-reports__media">
                     <img src="/assets/images/annualReport/annual-report-1.webp" alt="Godavari Biorefineries Ltd Annual Report 2025-26" loading="eager" fetchpriority="high">                 
                  </span>
                  <span class="site-btn site-btn--fill ar-reports__download">
                     <span class="site-btn__label">Download</span>
                     <span class="site-btn__arrow" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                     </span>
                  </span>
               </a>
            </li>
