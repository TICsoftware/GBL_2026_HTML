@{
    ViewData["Title"] = "Media Kit";
    var logo = Url.Content("~/Assets/images/logo/gbl-logo.svg");
    var somaiya = Url.Content("~/Assets/images/logo/somaiya-logo.svg");
    var icon192 = Url.Content("~/Assets/images/favicon/android-chrome-192x192.png");
    var icon512 = Url.Content("~/Assets/images/favicon/android-chrome-512x512.png");
    var brandFilm = Url.Content("~/Assets/images/homepage/banner/banner-video.mp4");
    var brandPoster = Url.Content("~/Assets/images/homepage/banner/banner-img-4.webp");
    var siteFilm = Url.Content("~/Assets/images/video/footer.mp4");
    var sitePoster = Url.Content("~/Assets/images/banners/about-us-banner.webp");
    var pdfBase = "https://www.godavaribiorefineries.com/sites/default/files/";
}

@section Styles {
   <link rel="stylesheet" href="~/Assets/css/insidepage-style.css" asp-append-version="true" />
   <link rel="stylesheet" href="~/Assets/css/media-kit.css" asp-append-version="true" />
}

   <section class="relative inside-banner-outer">
         <div class="inside-banner-inner banner-animation relative">
            <div class="overflow-hidden h-[75vh] sm:h-[700px] relative innerbanner-image-wrapper">
               <picture>
                  <source media="(min-width:1024px)"
                     srcset="~/Assets/images/banners/news_media_coverage-desktop.webp">
                  <img
                     src="~/Assets/images/banners/news_media_coverage-desktop.webp"
                     alt=""
                     class="innerbanner-image absolute left-0 top-0 w-full h-full object-cover"
                     loading="eager"
                     fetchpriority="high">
               </picture>
               <div class="innerbanner-overlay"></div>
            </div>

            <div class="innerbanner-caption absolute inset-0 z-30 flex items-center">
               <div class="container">
                  <div class="max-w-4xl text-left">
                     <h1 class="innerbanner-title text-h1 text-white title-animation">
                        Media Kit
                     </h1>

                     <nav class="breadcrumb-nav" aria-label="Breadcrumb">
                        <ol class="flex items-center gap-2 text-sm">
                           <li>
                              <a href="/" class="text-white/70 hover:text-white transition">Home</a>
                           </li>
                           <li class="text-white/60">/</li>
                           <li class="text-white">Media Kit</li>
                        </ol>
                     </nav>
                  </div>
               </div>
            </div>
         </div>
   </section>

   <section class="relative overflow-hidden section-spacing page-intro-outer bg-gray">
      <div class="container">
         <div class="page-intro-inner intro-lg text-center">
            <p>Official logos, leadership photographs, films and publications for journalists, partners and anyone telling the Godavari Biorefineries story. Please use these assets as provided, and credit Godavari Biorefineries Ltd.</p>
         </div>
      </div>
   </section>

   <div class="mk-page">
      <div class="mk-jump-sentinel" aria-hidden="true"></div>
      <section class="mk-jump" aria-label="Media kit sections">
         <div class="container">
            <div class="mk-jump__track">
               <button type="button" class="mk-jump__arrow mk-jump__arrow--prev" aria-label="Previous section">
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14.5 6 8.5 12l6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
               </button>
               <nav class="mk-jump__nav">
                  <a class="mk-jump__btn" href="#logos">Company Logos &amp; Brand Assets</a>
                  <a class="mk-jump__btn" href="#leadership">Leadership Profiles &amp; Photographs</a>
                  <a class="mk-jump__btn" href="#videos">Videos &amp; Multimedia</a>
                  <a class="mk-jump__btn" href="#media-contact">Media Relations Contact Information</a>
                  <a class="mk-jump__btn" href="#publications">Publications &amp; Brochures</a>
               </nav>
               <button type="button" class="mk-jump__arrow mk-jump__arrow--next" aria-label="Next section">
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9.5 6 15.5 12l-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
               </button>
            </div>
         </div>
      </section>

      <section class="mk-section section-spacing bg-gray" id="logos" aria-labelledby="logos-title">
         <div class="container">
            <div class="mk-head">
               <h2 id="logos-title" class="text-h2 title-animation">Company Logos &amp; Brand Assets</h2>
               <p>Use the logo in full, with clear space around the mark. Do not recolour, stretch, crop or place it on a busy background.</p>
            </div>

            <ul class="mk-grid mk-grid--4">
               <li class="mk-card">
                  <div class="mk-stage mk-stage--logo">
                     <img src="@logo" alt="Godavari Biorefineries Ltd logo">
                  </div>
                  <div class="mk-card__meta">
                     <div>
                        <h3 class="mk-card__title">GBL logo</h3>
                        <p class="mk-card__type">SVG</p>
                     </div>
                     <a class="mk-dl" href="@logo" download="gbl-logo.svg" aria-label="Download GBL logo, SVG">
                        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 4v11M7.5 11.5 12 16l4.5-4.5M6 20h12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                     </a>
                  </div>
               </li>
               <li class="mk-card">
                  <div class="mk-stage mk-stage--logo">
                     <img src="@somaiya" alt="Somaiya logo">
                  </div>
                  <div class="mk-card__meta">
                     <div>
                        <h3 class="mk-card__title">Somaiya logo</h3>
                        <p class="mk-card__type">SVG</p>
                     </div>
