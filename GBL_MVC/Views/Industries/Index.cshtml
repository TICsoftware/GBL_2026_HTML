@{
    ViewData["Title"] = "Industries";
}

@section Styles {
   <link rel="stylesheet" href="~/Assets/css/insidepage-style.css" asp-append-version="true" />
   <link rel="stylesheet" href="~/Assets/css/industries-style.css" asp-append-version="true" />
   <link rel="stylesheet" href="~/Assets/css/industries-filter.css" asp-append-version="true" />
   <link rel="stylesheet" href="~/Assets/css/industries-list.css" asp-append-version="true" />
}

    <!-- HERO BANNER END-->
   <section class="relative inside-banner-outer">
         <div class="inside-banner-inner banner-animation relative">
            <!-- Banner -->
            <div class="overflow-hidden h-[75vh] sm:h-[700px] relative innerbanner-image-wrapper">
               <!-- Parallax Image -->
               <picture>
                  <!-- Desktop -->
                  <source media="(min-width:1024px)"
                     srcset="~/Assets/images/banners/industries-we-serve-desktop.webp">

                  <!-- Tablet -->
                  <source media="(min-width:992px)"
                     srcset="~/Assets/images/banners/industries-we-serve-mob.webp">

                  <!-- Mobile -->
                  <img
                     src="~/Assets/images/banners/industries-we-serve-desktop.webp"
                     alt=""
                     class="innerbanner-image absolute left-0 top-0 w-full h-full object-cover"
                     loading="eager"
                     fetchpriority="high">
               </picture>
               <!-- Keep Existing Overlay -->
               <div class="innerbanner-overlay"></div>
            </div>
            <!-- Content -->
           
           <!--Breadcrumb-->
            <div class="innerbanner-caption absolute inset-0 z-30 flex items-center">
               <div class="container">
                  <div class="max-w-4xl text-left">
                     <h1 class="innerbanner-title text-h1 text-white title-animation">
                        Industries we serve
                     </h1>

                     <nav class="breadcrumb-nav" aria-label="Breadcrumb">
                        <ol class="flex items-center gap-2 text-sm">
                           <li>
                              <a href="/" class="text-white/70 hover:text-white transition">
                                 Home
                              </a>
                           </li>

                           <li class="text-white/60">/</li>

                           <li class="text-white">
                              Industries we serve
                           </li>
                        </ol>
                     </nav>
                  </div>
               </div>
            </div>  
         </div>
   </section>
    <!-- HERO BANNER END -->

   <!--PAGE INTRO OUTER-->
   <section class="relative overflow-hidden section-spacing page-intro-outer bg-gray">
       <div class="container">
         <div class="page-intro-inner intro-lg text-center">
            <p>Our vast portfolio of bio-based chemicals, which includes over 30 specialty bio-based chemicals, finds applications across diverse sectors from paints and pharmaceuticals to personal care and cosmetics. Guided by our principles of Innovation at the Core, Sustainability by Design and Shared Future Growth, we leverage our research and process innovation capabilities to co-create green solutions with our customers. Our bio-based chemicals are specifically engineered to address technical challenges and meet critical performance rssuirements. They also meet our customers' specifications in accordance with all applicable safety, health and environmental standards.</p>
         </div>      
      </div>
   </section>
   <!--PAGE INTRO OUTER END-->

  
   
   <!--INDUSTRIES LIST-->
   <section class="relative section-spacing industries-list-outer">
      <div class="container">
         <div class="section-intro">
            <div class="section-intro__title title-section">
              <h2 class="text-h2">Industry Portfolios</h2>
            </div>

            <!--FILTER OUTER-->
            <div class="filter-outer section-spacing-sm">
                  <button type="button"
                          class="filter-mobile-trigger"
                          data-open-industry-filter
                          aria-controls="industry-filter"
                          aria-expanded="false">
                     <span class="filter-mobile-trigger__icon" aria-hidden="true"></span>
                     Refine by Filters
                  </button>
                  <div class="filter-mobile-backdrop" data-close-industry-filter></div>
                  <form class="filter-inner" id="industry-filter" action="#" method="get">
                     <div class="filter-mobile-sheet-head">
                        <h2 class="filter-mobile-sheet-head__title">Set Filters</h2>
                        <button type="button" class="filter-mobile-close" data-close-industry-filter aria-label="Close filters">&times;</button>
                     </div>
                     <div class="industry-filters-desktop">
                     <div class="cselect">
                        <label class="cselect-sr" for="filter-industry">Industry</label>
                        <select id="filter-industry" name="industry" class="cselect-native">
                           <option value="" selected>Industry</option>
                           <option value="adhesives-lubricants">Adhesives &amp; Lubricants</option>
                           <option value="agrochemicals">Agrochemicals</option>
                           <option value="animal-feed">Animal Feed</option>
                           <option value="biofuels">Biofuels</option>
                           <option value="personal-care">Personal Care</option>
                           <option value="pharmaceuticals">Pharmaceuticals</option>
                        </select>
                     </div>

                     <div class="cselect">
                        <label class="cselect-sr" for="filter-application">Application</label>
                        <select id="filter-application" name="application" class="cselect-native">
                           <option value="" selected>Application</option>
                           <option value="coatings">Coatings</option>
                           <option value="personal-care">Personal Care</option>
                           <option value="pharmaceuticals">Pharmaceuticals</option>
                           <option value="animal-nutrition">Animal Nutrition</option>
                           <option value="energy">Energy</option>
                        </select>
                     </div>

                     <div class="cselect">
                        <label class="cselect-sr" for="filter-product-categories">Product Categories</label>
                        <select id="filter-product-categories" name="productCategories" class="cselect-native">
                           <option value="" selected>Product Categories</option>
                           <option value="bio-based-chemicals">Bio-based chemicals</option>
                           <option value="biofuels-bio-energy">Biofuels &amp; Bio-energy</option>
                           <option value="sugar">Sugar</option>
                           <option value="specialty-chemicals">Specialty chemicals</option>
                        </select>
                     </div>

                     <button type="submit" class="filter-submit">
                        <span class="filter-submit-arrow" aria-hidden="true">&rarr;</span>
                        Filter
                     </button>
                     </div>
                     <div class="industry-filters-mobile">
                        <div class="pf-dropdown" data-filter-group="industry" data-native="filter-industry" data-default-label="Industry">
                           <button type="button" class="pf-dropdown__trigger" aria-expanded="false" aria-controls="industry-filter-industry-panel">
                              <span>Industry</span>
                              <span class="pf-dropdown__chevron" aria-hidden="true"></span>
                           </button>
                           <div class="pf-dropdown__panel" id="industry-filter-industry-panel">
                              <div class="pf-dropdown__panel-clip">
                                 <div class="pf-dropdown__panel-inner">
                                    <button type="button" class="pf-option" data-value="adhesives-lubricants">Adhesives &amp; Lubricants</button>
                                    <button type="button" class="pf-option" data-value="agrochemicals">Agrochemicals</button>
                                    <button type="button" class="pf-option" data-value="animal-feed">Animal Feed</button>
                                    <button type="button" class="pf-option" data-value="biofuels">Biofuels</button>
                                    <button type="button" class="pf-option" data-value="personal-care">Personal Care</button>
                                    <button type="button" class="pf-option" data-value="pharmaceuticals">Pharmaceuticals</button>
                                 </div>
                              </div>
                           </div>
                        </div>
                        <div class="pf-dropdown" data-filter-group="application" data-native="filter-application" data-default-label="Application">
                           <button type="button" class="pf-dropdown__trigger" aria-expanded="false" aria-controls="industry-filter-application-panel">
                              <span>Application</span>
                              <span class="pf-dropdown__chevron" aria-hidden="true"></span>
                           </button>
                           <div class="pf-dropdown__panel" id="industry-filter-application-panel">
                              <div class="pf-dropdown__panel-clip">
                                 <div class="pf-dropdown__panel-inner">
                                    <button type="button" class="pf-option" data-value="coatings">Coatings</button>
                                    <button type="button" class="pf-option" data-value="personal-care">Personal Care</button>
                                    <button type="button" class="pf-option" data-value="pharmaceuticals">Pharmaceuticals</button>
                                    <button type="button" class="pf-option" data-value="animal-nutrition">Animal Nutrition</button>
                                    <button type="button" class="pf-option" data-value="energy">Energy</button>
                                 </div>
                              </div>
                           </div>
                        </div>
                        <div class="pf-dropdown" data-filter-group="category" data-native="filter-product-categories" data-default-label="Product Categories">
                           <button type="button" class="pf-dropdown__trigger" aria-expanded="false" aria-controls="industry-filter-category-panel">
                              <span>Product Categories</span>
                              <span class="pf-dropdown__chevron" aria-hidden="true"></span>
                           </button>
                           <div class="pf-dropdown__panel" id="industry-filter-category-panel">
                              <div class="pf-dropdown__panel-clip">
                                 <div class="pf-dropdown__panel-inner">
                                    <button type="button" class="pf-option" data-value="bio-based-chemicals">Bio-based chemicals</button>
                                    <button type="button" class="pf-option" data-value="biofuels-bio-energy">Biofuels &amp; Bio-energy</button>
                                    <button type="button" class="pf-option" data-value="sugar">Sugar</button>
                                    <button type="button" class="pf-option" data-value="specialty-chemicals">Specialty chemicals</button>
                                 </div>
                              </div>
                           </div>
                        </div>
                     </div>
                     <div class="filter-mobile-sheet-foot">
                        <button type="button" class="filter-mobile-clear" data-clear-industry-filter>Clear Filters</button>
                        <button type="button" class="filter-mobile-apply" data-apply-industry-filter>Apply Filters</button>
                     </div>
                  </form>
            </div>
            <!--FILTER OUTER END-->
         </div>
      </div>    
      
