@{
    ViewData["Title"] = "Investor Relations";
}

@section Styles {
   <link rel="stylesheet" href="~/Assets/css/insidepage-style.css" asp-append-version="true" />
   <link rel="stylesheet" href="~/Assets/css/investor.css" asp-append-version="true" />
}

    <!-- HERO BANNER END-->
   <section class="relative inside-banner-outer">
         <div class="inside-banner-inner banner-animation relative">
            <!-- Banner -->
            <div class="overflow-hidden h-[75vh] sm:h-[700px] relative innerbanner-image-wrapper">
               <!-- Parallax Image -->
               <picture>
                  <!-- Desktop -->
                  <source media="(min-width:1024px)"
                     srcset="~/Assets/images/banners/investor-banner.webp">

                  

                  <!-- Mobile -->
                  <img
                     src="~/Assets/images/banners/investor-banner.webp"
                     alt=""
                     class="innerbanner-image absolute left-0 top-0 w-full h-full object-cover"
                     loading="eager"
                     fetchpriority="high">
               </picture>
               <!-- Keep Existing Overlay -->
               <div class="innerbanner-overlay"></div>
            </div>
            <!-- Content -->
           
           <!--Breadcrumb-->
            <div class="innerbanner-caption absolute inset-0 z-30 flex items-center">
               <div class="container">
                  <div class="max-w-4xl text-left">
                     <h1 class="innerbanner-title text-h1 text-white title-animation">Investor Relations</h1>

                     <nav class="breadcrumb-nav" aria-label="Breadcrumb">
                        <ol class="flex items-center gap-2 text-sm">
                           <li><a href="/" class="text-white/70 hover:text-white transition">Home</a></li>                           
                           <li class="text-white/60">/</li>
                           <li class="text-white">Investor Relations</li>
                        </ol>
                     </nav>
                  </div>
               </div>
            </div>  
         </div>
   </section>
    <!-- HERO BANNER END -->

   <!--PAGE INTRO OUTER-->
   <section class="relative overflow-hidden section-spacing page-intro-outer bg-gray">
       <div class="container">
         <div class="page-intro-inner intro-lg text-center">
            <p>Godavari Biorefineries Ltd. is committed to disciplined corporate governance, transparent market disclosures and consistent shareholder communication. This repository houses all essential investor information, including financial statements, share and stock data, statutory policies, press releases and meeting disclosures to support informed decision-making.</p>
         </div>      
      </div>
   </section>
   <!--PAGE INTRO OUTER END-->

   <!--What's New-->
   <section class="whatsNew section-spacing" aria-labelledby="whats-new-title">
      <div class="container">
         <h2 id="whats-new-title" class="whatsNew__title text-h2">What's New</h2>

         <div class="whatsNew__grid">
            <article class="whatsNew__card">
               <p class="whatsNew__meta"><span class="whatsNew__tag">Press Release</span><time datetime="2026-02-07">Feb 07, 2026</time></p>
               <h3>Godavari Biorefineries Limited partners with Synthomer to develop bio-based alternatives to fossil-based monomers</h3>
               <a href="/news/press-release" class="site-btn site-btn--line">
                  <span class="site-btn__label">Read More</span>
                  <span class="site-btn__arrow" aria-hidden="true">
                     <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
               </a>
            </article>

            <article class="whatsNew__card">
               <p class="whatsNew__meta"><span class="whatsNew__tag">Press Release</span><time datetime="2025-12-17">Dec 17, 2025</time></p>
               <h3>Sathgen Therapeutics Division of Godavari Biorefineries Ltd, India, Expands to the U.S. with Launch of Princeton Based Subsidiary</h3>
               <a href="/news/press-release" class="site-btn site-btn--line">
                  <span class="site-btn__label">Read More</span>
                  <span class="site-btn__arrow" aria-hidden="true">
                     <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
               </a>
            </article>

            <article class="whatsNew__card whatsNew__card--media">
               <div class="whatsNew__media">
                  <img src="@Url.Content("~/Assets/images/press-release/mini-1.png")" alt="Godavari Biorefineries plant">
               </div>
               <p class="whatsNew__meta"><span class="whatsNew__tag">Media Coverage</span><time datetime="2026-02-07">Feb 07, 2026</time></p>
               <p>Nam vel sapien sit amet ipsum laoreet aliquam. Donec iaculis semper est non aliquam.</p>
            </article>

            <div class="whatsNew__aside">
               <div class="whatsNew__quote" data-inv-quote>
                 <script type="module" src="https://widgets.tradingview-widget.com/w/en/tv-single-ticker.js"></script>
                 <tv-single-ticker symbol="BSE:GODAVARIB"></tv-single-ticker>
               </div>
               <article class="whatsNew__card whatsNew__card--note">
                  <h3>Announcement</h3>
                  <p>Nam vel sapien sit amet ipsum laoreet aliquam. Donec iaculis semper est non aliquam.</p>
               </article>
            </div>
         </div>

