@{
    var section = ViewData["NewsSection"] as string ?? "press-release";
    var isPress = section == "press-release";
    var pageTitle = isPress ? "Press Release" : "Media Coverage";
}

<section class="relative inside-banner-outer">
      <div class="inside-banner-inner banner-animation relative">
         <div class="overflow-hidden h-[75vh] sm:h-[700px] relative innerbanner-image-wrapper">
            <picture>
               <source media="(min-width:1024px)"
                  srcset="~/Assets/images/banners/news_media_coverage-desktop.webp">
               <img
                  src="~/Assets/images/banners/news_media_coverage-desktop.webp"
                  alt=""
                  class="innerbanner-image absolute left-0 top-0 w-full h-full object-cover"
                  loading="eager"
                  fetchpriority="high">
            </picture>
            <div class="innerbanner-overlay"></div>
         </div>

         <div class="innerbanner-caption absolute inset-0 z-30 flex items-center">
            <div class="container">
               <div class="max-w-4xl text-left">
                  <h1 class="innerbanner-title text-h1 text-white title-animation">
                     @pageTitle
                  </h1>

                  <nav class="breadcrumb-nav" aria-label="Breadcrumb">
                     <ol class="flex items-center gap-2 text-sm">
                        <li>
                           <a href="/" class="text-white/70 hover:text-white transition">Home</a>
                        </li>
                        <li class="text-white/60">/</li>
                        <li>
                           <a href="/news/press-release" class="text-white/70 hover:text-white transition">News</a>
                        </li>
                        <li class="text-white/60">/</li>
                        <li class="text-white">@pageTitle</li>
                     </ol>
                  </nav>
               </div>
            </div>
         </div>
      </div>
</section>

<section class="relative section-spacing pb-0!">
<div class="container">
   <div class="tab-outer mb-3">
      <div class="industry-tabs" role="tablist" aria-label="News categories">
         <span class="industry-tabs__thumb" aria-hidden="true"></span>
         <a href="/news/PressRelease"
            class="industry-tab@(isPress ? " is-active" : "")"
            id="tab-btn-PressRelease"
            role="tab"
            aria-selected="@(isPress ? "true" : "false")"
            aria-controls="tab-PressRelease"
            data-tab="PressRelease">
            Press Release
         </a>
         <a href="/news/MediaCoverage"
            class="industry-tab@(!isPress ? " is-active" : "")"
            id="tab-btn-MediaCoverage"
            role="tab"
            aria-selected="@(!isPress ? "true" : "false")"
            aria-controls="tab-MediaCoverage"
            data-tab="MediaCoverage">
            Media Coverage
         </a>
      </div>
   </div>
</div>
</section>
