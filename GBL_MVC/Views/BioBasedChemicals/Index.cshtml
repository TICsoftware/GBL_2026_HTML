@{
    ViewData["Title"] = "Bio-Based Chemicals";
}

@section Styles {
   <link rel="stylesheet" href="~/Assets/css/insidepage-style.css" asp-append-version="true" />
   <link rel="stylesheet" href="~/Assets/css/industries-filter.css" asp-append-version="true" />
   <link rel="stylesheet" href="~/Assets/css/bio-based-chemicals.css" asp-append-version="true" />
}

    <!-- HERO BANNER -->
   <section class="relative inside-banner-outer">
         <div class="inside-banner-inner banner-animation relative">
            <div class="overflow-hidden h-[75vh] sm:h-[700px] relative innerbanner-image-wrapper">
               <picture>
                  <source media="(min-width:1024px)"
                     srcset="~/Assets/images/banners/bio-based-chemicals-banner.webp">
                  <img
                     src="~/Assets/images/banners/bio-based-chemicals-banner.webp"
                     alt=""
                     class="innerbanner-image absolute left-0 top-0 w-full h-full object-cover"
                     loading="eager"
                     fetchpriority="high">
               </picture>
               <div class="innerbanner-overlay"></div>
            </div>

            <div class="innerbanner-caption absolute inset-0 z-30 flex items-center">
               <div class="container">
                  <div class="bbc-banner-text text-left">
                     <h1 class="innerbanner-title text-h1 text-white title-animation">
                        Greening Supply Chains Across Sectors With Bio-Based Chemicals
                     </h1>

                     <nav class="breadcrumb-nav" aria-label="Breadcrumb">
                        <ol class="flex items-center gap-2 text-sm">
                           <li>
                              <a href="/" class="text-white/70 hover:text-white transition">Home</a>
                           </li>
                           <li class="text-white/60">/</li>
                           <li>
                              <a href="/Business" class="text-white/70 hover:text-white transition">Businesses</a>
                           </li>
                           <li class="text-white/60">/</li>
                           <li class="text-white">Bio-Based Chemicals</li>
                        </ol>
                     </nav>
                  </div>
               </div>
            </div>
         </div>
   </section>
    <!-- HERO BANNER END -->

   <!--PAGE INTRO OUTER-->
   <section class="bbc-intro" aria-label="Introduction">
      <div class="container">
         <div class="bbc-intro__copy page-intro-inner">
            <p class="bbc-intro__lead">Companies around the world are reimagining their global supply chains to reduce their carbon footprint and meet the consumer demand for eco-friendly, ethical, clean-label products. Godavari is at the forefront of this transition to green chemistry as a leading manufacturer of bio-based chemicals, transforming agricultural feedstock into sustainable alternatives to fossil-based products.</p>
            <p>Pioneering the creation of a green pathway to industrial chemicals by manufacturing bio-based chemicals at our Sakarwadi plant in Maharashtra since the 1990s, we have one of the largest portfolios today. Our bio-based chemicals find applications in a wide range of industries from agrochemicals to fragrances and flavours, plastics and paints, pharmaceuticals and personal care. We have developed them through our strong capabilities in scientific research and process innovation and in co-creation with leading corporations worldwide, and we supply them to customers in nearly 50 countries, including USA, UK, Germany and France as well as China, Japan, Singapore and UAE.</p>
         </div>
      </div>
   </section>
   <!--PAGE INTRO OUTER END-->

   <!--Strong Leadership Across Chemicals-->
   <section class="bbc-leadership bg-parallax-section" aria-labelledby="bbc-leadership-title">
      <div class="parallax-wrap bbc-leadership__bg" data-parallax-travel="10" aria-hidden="true">
         <img src="~/Assets/images/bio-based-chemicals/leadership-bg.webp" alt="" class="parallax-img" width="2048" height="738" loading="lazy">
      </div>
      <div class="bbc-leadership__veil" aria-hidden="true"></div>
      <div class="container">
         <div class="bbc-leadership__copy card-rise">
            <h2 id="bbc-leadership-title" class="text-h2 title-animation bbc-title">Strong Leadership Across Chemicals</h2>
            <div class="bbc-body">
               <p>We are a pioneer in the manufacture of bio-based 1,3 Butylene Glycol from an agricultural feedstock. Godavari’s bio-based 1,3 Butylene Glycol, which is branded as NaturoBG, is used by some of the most discerning personal care and cosmetic brands in the world.</p>
               <p>Our portfolio includes ~30 high-value, high-performance bio-based specialty chemicals such as Biobased Acetic Acid, Biobased Butanol and paraldehyde. We are the only manufacturer in India of bio-based Ethyl Acetate, bio-based Crotonaldehyde and bio-based Ethyl Vinyl Ether (EVE). EVE, which finds applications in products like fragrances, pharmaceuticals, coatings and agrochemicals, was largely fossil-based and fully imported into India earlier. We developed and scaled bio-based EVE in-house to meet the stringent requirements of our Indian customers and international partners.</p>
            </div>
         </div>
      </div>
   </section>
   <!--Strong Leadership Across Chemicals END-->

   <!--Drop-in Substitutes-->
   <section class="bbc-substitutes" aria-labelledby="bbc-substitutes-title">
      <div class="container">
         <div class="bbc-split">
            <div class="bbc-split__media bbc-parallax">
               <img src="~/Assets/images/bio-based-chemicals/drop-in-substitutes.webp" alt="Plant extract being poured into laboratory glassware" width="1448" height="1086" loading="lazy">
            </div>
            <div class="bbc-split__copy card-rise">
               <h2 id="bbc-substitutes-title" class="text-h2 title-animation bbc-title bbc-title--substitutes">Drop-in Substitutes with Enhanced Properties</h2>
               <div class="bbc-body bbc-body--muted">
                  <p>We continue to expand our portfolio and increase the share of high-value bio-based specialty chemicals by working with customers across geographies and end-use applications to co-create solutions that:</p>
                  <ul class="list-icon">
                     <li>Provide green drop-in substitutes with a lower carbon footprint to meet the companies’ sustainability goals</li>
                     <li>Make green substitutes with enhanced properties that are not dependent on crude oil prices and availability</li>
                  </ul>
                  <p>Our bio-based products are certified by international bodies like ISCC Plus, Ecocert, COSMOS and the US Department of Agriculture (USDA). By providing a clear, auditable line of sight from the farmer’s field to the final chemical intermediate, we have built our customers’ trust and confidence for wider market adoption.</p>
                  <p>As regulatory norms and environmental consciousness accelerate the global shift towards decarbonisation, India with its abundant biomass and innovation capabilities can become a global supplier of green chemistry solutions. Godavari intends to remain at the forefront of this shift and play a leading role in the green manufacturing ecosystem as a co-creator and supplier of high-performance, sustainable bio-based chemical solutions.</p>
               </div>
            </div>
         </div>
      </div>
   </section>
   <!--Drop-in Substitutes END-->

   <!--Find Your Bio-Based Chemical-->
   <section class="bbc-find" aria-labelledby="bbc-find-title">
      <div class="container">
         <div class="bbc-find__card">
            <div class="bbc-find__bg" aria-hidden="true">
               <img src="~/Assets/images/bio-based-chemicals/find-chemical-bg.webp" alt="" width="2048" height="688" loading="lazy">
            </div>
            <div class="bbc-find__content">
               <h2 id="bbc-find-title" class="text-h2 title-animation bbc-title">Find Your Bio-Based Chemical</h2>

               <div class="filter-outer bbc-find__filter">
                  <button type="button"
                          class="filter-mobile-trigger"
                          data-open-industry-filter
                          aria-controls="bbc-product-filter"
                          aria-expanded="false">
                     <span class="filter-mobile-trigger__icon" aria-hidden="true"></span>
                     Refine by Filters
                  </button>
                  <div class="filter-mobile-backdrop" data-close-industry-filter></div>
                  <form class="filter-inner" id="bbc-product-filter" action="#" method="get">
                     <div class="filter-mobile-sheet-head">
                        <h2 class="filter-mobile-sheet-head__title">Set Filters</h2>
                        <button type="button" class="filter-mobile-close" data-close-industry-filter aria-label="Close filters">&times;</button>
                     </div>
                     <div class="industry-filters-desktop">
                        <div class="cselect">
                           <label class="cselect-sr" for="bbc-filter-industry">Industry</label>
                           <select id="bbc-filter-industry" name="industry" class="cselect-native">
                              <option value="" selected>Industry</option>
                              <option value="adhesives-lubricants">Adhesives &amp; Lubricants</option>
                              <option value="agrochemicals">Agrochemicals</option>
                              <option value="animal-feed">Animal Feed</option>
                              <option value="biofuels">Biofuels</option>
                              <option value="personal-care">Personal Care</option>
                              <option value="pharmaceuticals">Pharmaceuticals</option>
                           </select>
                        </div>

                        <div class="cselect">
                           <label class="cselect-sr" for="bbc-filter-application">Application</label>
                           <select id="bbc-filter-application" name="application" class="cselect-native">
                              <option value="" selected>Application</option>
                              <option value="coatings">Coatings</option>
                              <option value="personal-care">Personal Care</option>
                              <option value="pharmaceuticals">Pharmaceuticals</option>
                              <option value="animal-nutrition">Animal Nutrition</option>
                              <option value="energy">Energy</option>
                           </select>
                        </div>

                        <div class="cselect">
                           <label class="cselect-sr" for="bbc-filter-product-categories">Product Categories</label>
                           <select id="bbc-filter-product-categories" name="productCategories" class="cselect-native">
                              <option value="" selected>Product Categories</option>
                              <option value="bio-based-chemicals">Bio-based chemicals</option>
                              <option value="biofuels-bio-energy">Biofuels &amp; Bio-energy</option>
                              <option value="sugar">Sugar</option>
                              <option value="specialty-chemicals">Specialty chemicals</option>
                           </select>
                        </div>

                        <button type="submit" class="filter-submit">
                           <span class="filter-submit-arrow" aria-hidden="true">&rarr;</span>
                           Filter
                        </button>
                     </div>
                     <div class="filter-mobile-sheet-foot">
                        <button type="button" class="filter-mobile-clear" data-clear-industry-filter>Clear Filters</button>
                        <button type="button" class="filter-mobile-apply" data-apply-industry-filter>Apply Filters</button>
                     </div>
                  </form>
               </div>
            </div>
         </div>
      </div>
   </section>
   <!--Find Your Bio-Based Chemical END-->

@section Scripts {
   <script src="~/Assets/js/card-animation.js" asp-append-version="true"></script>
   <script src="~/Assets/js/industries-filter.js" asp-append-version="true"></script>
   <script src="~/Assets/js/bio-based-chemicals.js" asp-append-version="true"></script>
}
