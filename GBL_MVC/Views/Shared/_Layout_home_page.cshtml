<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
@{
    var nonce = Context.Items["CSPNonce"]?.ToString();
}

  <!-- ✅ Favicon -->
  <link rel="icon" href="~/Assets/images/favicon/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="~/Assets/images/favicon/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="~/Assets/images/favicon/favicon-16x16.png">
  <!-- Apple -->
  <link rel="apple-touch-icon" href="~/Assets/images/favicon/apple-touch-icon.png">
  <!-- Android -->
  <link rel="icon" type="image/png" sizes="192x192" href="~/Assets/images/favicon/android-chrome-192x192.png">
  <link rel="icon" type="image/png" sizes="512x512" href="~/Assets/images/favicon/android-chrome-512x512.png">

   <link rel="preconnect" href="https://fonts.googleapis.com">
   <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
   <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">

  @RenderSection("head", required: false)
  
  <link rel="preload" href="~/dist/site.css" as="style"  onload="this.onload=null;this.rel='stylesheet'" asp-append-version="true">
  <link rel="stylesheet" href="~/dist/site.css" asp-append-version="true" />

  <link rel="preload" href="~/Assets/css/header-footer.css" as="style">
  <link rel="stylesheet" href="~/Assets/css/header-footer.css">
  
  <link rel="preload" href="~/Assets/css/common-style.css" as="style">
  <link rel="stylesheet" href="~/Assets/css/common-style.css">



  @RenderSection("Styles", required: false)
</head>

<body>

  
  @{
    var isHomePage =
    ViewContext.RouteData.Values["controller"]?.ToString() == "Home" &&
    ViewContext.RouteData.Values["action"]?.ToString() == "Index";
  }

  @if (isHomePage)
  {
    @* Preloader — sibling of header, first thing in <body> so it paints
       before anything else. Logic in homepage-preloader.js. *@
    <div id="sitePreloader" class="site-preloader" aria-hidden="true">
      <div class="site-preloader__logo-wrap">
        <img id="sitePreloaderLogo" class="site-preloader__logo" src="~/Assets/images/common-images/dahad-2.gif" alt="" />
      </div>
      <div class="site-preloader__progress">
        <div class="site-preloader__bar"><span class="site-preloader__bar-fill" id="sitePreloaderFill"></span></div>
        <div class="site-preloader__counter" id="sitePreloaderCounter">0<span>%</span></div>
      </div>
    </div>
  }

 @Html.Partial("~/Views/Shared/_Header.cshtml")


      <main id="main-content">
            @RenderBody()

         @Html.Partial("~/Views/Shared/_Footer.cshtml")

      </main>



      <!-- Back to top -->
      <button type="button"
              class="back-to-top fixed bottom-3 right-5 w-8 h-8 sm:w-10 sm:h-10 rounded-full
                     bg-black/70 text-white flex items-center justify-center
                     cursor-pointer z-50 opacity-0 pointer-events-none
                     transition-all duration-300"
              aria-label="Back to top"
              aria-hidden="true">

         <svg class="progress-ring absolute inset-0 w-full h-full -rotate-90 pointer-events-none" viewBox="0 0 100 100"
            preserveAspectRatio="xMidYMid meet" aria-hidden="true">
            <circle class="progress-ring-track" cx="50" cy="50" r="45" stroke="rgba(255,255,255,0.2)" stroke-width="6" fill="transparent" />
            <circle class="progress-ring-circle" cx="50" cy="50" r="45" stroke="#ED1C24" stroke-width="6" fill="transparent"
            stroke-linecap="round" />
         </svg>

         <span class="relative z-10 flex items-center justify-center" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
            <path d="M12 19V5M12 5L6 11M12 5L18 11" stroke="white" stroke-width="2" stroke-linecap="round" />
            </svg>
         </span>
      </button>



   <!-- COOKIE POLICY -->
